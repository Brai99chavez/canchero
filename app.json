{
  "expo": {
    "name": "Canchero",
    "slug": "cancha-app",
    "scheme": "canchero",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bclandinglab.canchero"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D1124",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bclandinglab.canchero",
      "googleServicesFile": "./google-services.json",
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#0D1124",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "La app usa tus fotos para ponerle cara a los jugadores del plantel."
        }
      ],
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0D1124",
          "imageWidth": 320,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#4BF0A5"
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "braian-chavez",
          "project": "canchero"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "80a393da-b38f-4f6d-80e9-cbd3c1ab9226"
      },
      "apiUrl": "https://canchero.onrender.com",
      "sentryDsn": "https://625ee50d4bf747ec5a4efdba2130d416@o4511657200713728.ingest.us.sentry.io/4512102977437696"
    },
    "owner": "brai_chavez",
    "updates": {
      "url": "https://u.expo.dev/80a393da-b38f-4f6d-80e9-cbd3c1ab9226"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
