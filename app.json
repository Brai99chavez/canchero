{
  "expo": {
    "name": "Canchero",
    "slug": "cancha-app",
    "scheme": "canchero",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kubrik.canchero"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D1124",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kubrik.canchero",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#0D1124",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "La app usa tus fotos para ponerle cara a los jugadores del plantel."
        }
      ],
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0D1124",
          "imageWidth": 320,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#4BF0A5"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "80a393da-b38f-4f6d-80e9-cbd3c1ab9226"
      },
      "apiUrl": "https://canchero.onrender.com"
    },
    "owner": "brai_chavez"
  }
}
