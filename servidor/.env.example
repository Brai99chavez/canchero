# Cadena de conexión de Neon (Dashboard > Connection string, con pooling).
# SECRETA: vive sólo acá y en las variables de entorno de Render.
DATABASE_URL=postgresql://usuario:clave@ep-algo.neon.tech/neondb?sslmode=require

# Clave con la que se firman las sesiones. Generar una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SECRETA. Si cambia, se cierran todas las sesiones abiertas.
AUTH_SECRET=

# La URL pública del servicio, sin barra al final.
# En local: http://localhost:3000
BASE_URL=https://canchero-api.onrender.com

# Origenes extra permitidos, separados por comas. Para probar con Expo Go hace
# falta "exp://*", porque ahi el origen no es el esquema de la app. Sacarlo
# antes de publicar.
TRUSTED_ORIGINS=exp://*/*

# Fotos de los jugadores, en Cloudflare R2. Sin estas variables la app anda
# igual y las fotos quedan sólo en cada telefono.
# Las tres primeras son SECRETAS; la publica no.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=canchero-images
R2_PUBLIC_URL=https://pub-c1bd7e9142d14e08a489018406b9ba06.r2.dev
